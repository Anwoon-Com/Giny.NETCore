<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Servers\Giny.World\Giny.World.csproj" />
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(SolutionDir)' != '*Undefined*' and '$(SolutionDir)' != ''">
    <MakeDir Directories="$(SolutionDir)\Servers\Giny.World\bin\$(Configuration)\net6.0\Modules" />
    <Copy SourceFiles="$(TargetDir)\Giny.SmithmagicMonsters.dll" DestinationFiles="$(SolutionDir)\Servers\Giny.World\bin\$(Configuration)\net6.0\Modules\Giny.SmithmagicMonsters.dll" SkipUnchangedFiles="true" />
  </Target>

</Project>
